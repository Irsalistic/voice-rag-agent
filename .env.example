# Copy to .env and fill in the providers you want.
# With nothing filled in, Vesper still runs: local embeddings, extractive
# answers grounded in your documents, browser speech recognition, and edge-tts.

APP_NAME=Vesper
ENVIRONMENT=development
DATA_DIR=./data
AUTO_INGEST_EXAMPLES=true
SERVE_FRONTEND=true

# Comma-separated browser origins for local dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# auto | openai | groq | ollama | extractive
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# auto | fastembed | openai | hashing
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

CHUNK_SIZE=700
CHUNK_OVERLAP=120
RETRIEVAL_K=8
RERANK_K=4

# auto | openai | faster_whisper | none
STT_PROVIDER=auto
WHISPER_MODEL=base
OPENAI_STT_MODEL=whisper-1

# auto | openai | edge | piper | none
TTS_PROVIDER=auto
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
EDGE_TTS_VOICE=en-US-AriaNeural
PIPER_BIN=piper
PIPER_MODEL=

MAX_UPLOAD_BYTES=10485760
MEMORY_TURNS=8
